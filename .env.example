# SAKR — copy to .env.local and fill in.

# MongoDB Atlas. On networks that can't resolve SRV records (e.g. a phone hotspot),
# use the standard multi-host URI instead of mongodb+srv://.
MONGODB_URI=mongodb://USER:PASSWORD@host1:27017,host2:27017,host3:27017/?ssl=true&replicaSet=REPLICA_SET&authSource=admin&retryWrites=true&w=majority
MONGODB_DB=sakr
