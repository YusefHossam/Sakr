# SAKR — copy to .env.local and fill in.

# MongoDB Atlas. On networks that can't resolve SRV records (e.g. a phone hotspot),
# use the standard multi-host URI instead of mongodb+srv://.
MONGODB_URI=mongodb://USER:PASSWORD@host1:27017,host2:27017,host3:27017/?ssl=true&replicaSet=REPLICA_SET&authSource=admin&retryWrites=true&w=majority
MONGODB_DB=sakr

# Signs session cookies. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# The owner's admin login. Create it with: npm run create-admin
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ---------- Optional (all free tiers) ----------
# Card payments via Paymob test mode. Card checkout stays disabled until all four are set.
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_HMAC_SECRET=
# AI Stylist via Gemini's free tier (https://aistudio.google.com/apikey). Without it the stylist uses house rules.
GEMINI_API_KEY=
# Optional model override (default gemini-flash-latest, then gemini-flash-lite-latest when busy).
GEMINI_MODEL=
# Hugging Face token (free) gives the try-on Space a bigger quota. Optional.
HF_TOKEN=
# Try-on Space id (default yisol/IDM-VTON).
TRYON_SPACE=
